# Pepeuch AI Cluster - server environment

DATA_ROOT=/opt/pepeuch-ai
MODEL_ROOT=/opt/pepeuch-ai/models

# Database
POSTGRES_VERSION=16-alpine
POSTGRES_DB=pepeuch_ai
POSTGRES_USER=pepeuch
POSTGRES_PASSWORD=CHANGE_ME

# Ray
RAY_VERSION=2.57.0-py311
RAY_GCS_PORT=6379
RAY_DASHBOARD_PORT=8265
RAY_CLIENT_PORT=10001

# Open WebUI
OPEN_WEBUI_TAG=main
OPEN_WEBUI_PORT=3000
WEBUI_SECRET_KEY=CHANGE_ME

# Ollama (optional profile: llm)
OLLAMA_TAG=latest
OLLAMA_PORT=11434

# Qdrant (optional profile: rag)
QDRANT_TAG=latest
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Scheduler skeleton (optional profile: scheduler)
SCHEDULER_PORT=8088